<?xml version="1.0" encoding="utf-8"?><!-- merge：渲染根就是 SelfRenderAdView（FrameLayout），不再套一层容器。
     卡片视觉（背景/圆角/高程）在代码里设置，外边距由承载方设置，见 SelfRenderAdView。 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- 左图右文 -->
    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 媒体位：封面垫底、播放器覆盖其上，统一圆角裁剪（clipToOutline 在代码里开，见 SelfRenderAdView）
             不用 Glide RoundedCorners，避免视图未测量时双重缩放导致图片变形 -->
        <FrameLayout
            android:id="@+id/flMedia"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/bg_ad_media">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/llText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ad_title"
                android:textSize="16sp"
                tools:text="标题最多两行，超出省略" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ad_desc"
                android:textSize="13sp"
                tools:text="描述文案最多两行" />

            <TextView
                android:id="@+id/tvSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ad_desc"
                android:textSize="11sp"
                tools:text="应用名称" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 合规角标：三方广告显示其平台 logo，ATFO 自家广告只有「广告」文字 -->
                <LinearLayout
                    android:id="@+id/llBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_ad_badge_wrapper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/ivBadgeLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tvBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ad_badge_text"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:text="广告"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 按钮：buttonText 为图片地址时显示图片（服务端下发图形式 CTA），否则显示文字 -->
                <FrameLayout
                    android:id="@+id/flMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ad_cta"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingTop="5dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="立即下载" />

                    <ImageView
                        android:id="@+id/ivMoreImage"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角 ✕：点击经 registerInteraction 的 closeViews 交回 SDK 处理关闭上报 -->
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="2dp"
        android:src="@drawable/ic_close" />
</merge>
