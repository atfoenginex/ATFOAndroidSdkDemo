<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="设置"
            android:textColor="@color/ad_title"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="接入参数与代码位运行时配置"
            android:textColor="@color/ad_desc"
            android:textSize="13sp" />

        <!-- 接入参数自检：与主页 tv_state 同风格，onResume 时刷新 -->
        <TextView
            android:id="@+id/tv_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_ad_card"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:textColor="@color/ad_title"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="4dp"
            android:text="调试"
            android:textColor="@color/ad_desc"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ad_card"
            android:elevation="1dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_debug"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="打开 ATFO Debug 页面" />

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowDesc"
                        android:text="SDK 调试面板：配置缓存、AB 实验分组、日志导出" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="4dp"
            android:text="代码位（点击切换，候选来自后台下发的配置缓存）"
            android:textColor="@color/ad_desc"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ad_card"
            android:elevation="1dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_slot_splash"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="开屏广告位" />

                    <TextView
                        android:id="@+id/tv_slot_splash"
                        style="@style/Widget.AtfoDemo.EntryRowDesc" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>

            <View style="@style/Widget.AtfoDemo.EntryRowDivider" />

            <LinearLayout
                android:id="@+id/row_slot_feed"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="信息流广告位（模板渲染）" />

                    <TextView
                        android:id="@+id/tv_slot_feed"
                        style="@style/Widget.AtfoDemo.EntryRowDesc" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>

            <View style="@style/Widget.AtfoDemo.EntryRowDivider" />

            <LinearLayout
                android:id="@+id/row_slot_feed_self_render"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="信息流广告位（宿主自渲染）" />

                    <TextView
                        android:id="@+id/tv_slot_feed_self_render"
                        style="@style/Widget.AtfoDemo.EntryRowDesc" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>

            <View style="@style/Widget.AtfoDemo.EntryRowDivider" />

            <LinearLayout
                android:id="@+id/row_slot_interstitial"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="插屏广告位" />

                    <TextView
                        android:id="@+id/tv_slot_interstitial"
                        style="@style/Widget.AtfoDemo.EntryRowDesc" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>

            <View style="@style/Widget.AtfoDemo.EntryRowDivider" />

            <LinearLayout
                android:id="@+id/row_slot_reward"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="激励视频广告位" />

                    <TextView
                        android:id="@+id/tv_slot_reward"
                        style="@style/Widget.AtfoDemo.EntryRowDesc" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>

            <View style="@style/Widget.AtfoDemo.EntryRowDivider" />

            <LinearLayout
                android:id="@+id/row_slot_notify"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="通知广告位（信息流-通知广告）" />

                    <TextView
                        android:id="@+id/tv_slot_notify"
                        style="@style/Widget.AtfoDemo.EntryRowDesc" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>

            <View style="@style/Widget.AtfoDemo.EntryRowDivider" />

            <LinearLayout
                android:id="@+id/row_refresh"
                style="@style/Widget.AtfoDemo.EntryRow">

                <LinearLayout style="@style/Widget.AtfoDemo.EntryRowText">

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowTitle"
                        android:text="刷新配置缓存" />

                    <TextView
                        style="@style/Widget.AtfoDemo.EntryRowDesc"
                        android:text="向后台拉取最新代码位列表，候选为空时先点这里" />
                </LinearLayout>

                <ImageView style="@style/Widget.AtfoDemo.EntryRowChevron" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
