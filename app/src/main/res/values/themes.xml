<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ATFOAndroidSdkDemo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.ATFOAndroidSdkDemo" parent="Base.Theme.ATFOAndroidSdkDemo" />

    <!-- 广告页顶部操作按钮：等高胶囊、去掉 Material3 按钮默认上下 6dp 内缩与按压高程，
         三个按钮只换 backgroundTint，尺寸/字号/圆角保持一致 -->
    <style name="Widget.AtfoDemo.AdButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">22dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- 首页入口列表：一行 = 主标题 + 一行说明 + 右侧箭头，样式集中在 style 里，
         布局文件每行只写文案，方便后续增删广告类型。
         parent="" 是必须的：否则 AAPT 会把名字里的点当成隐式父级去找 Widget.AtfoDemo -->
    <style name="Widget.AtfoDemo.EntryRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.AtfoDemo.EntryRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.AtfoDemo.EntryRowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/ad_title</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.AtfoDemo.EntryRowDesc" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/ad_desc</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.AtfoDemo.EntryRowChevron" parent="">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
    </style>

    <style name="Widget.AtfoDemo.EntryRowDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>