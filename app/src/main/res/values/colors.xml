<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- 广告页三个操作按钮的底色：加载/展示用实色，返回用中性浅灰弱化为次要操作 -->
    <color name="btn_load">#3D5AFE</color>
    <color name="btn_show">#00A870</color>
    <color name="btn_back">#F3F4F6</color>
    <color name="btn_back_text">#374151</color>

    <!-- 首页：浅灰页面底 + 白色入口列表，靠底色差拉开层次，不再用大色块按钮 -->
    <color name="page_bg">#F5F6F8</color>
    <color name="divider">#EEF0F2</color>

    <!-- 广告容器黄色底：各容器型广告页共用，肉眼确认容器实际边界与占位 -->
    <color name="ad_container_bg">#F7C948</color>

    <!-- 调试 Console（ConsoleView）：终端风深色卡片 -->
    <color name="console_bg">#1B1B1F</color>
    <color name="console_text">#EDEDED</color>
    <color name="console_title">#8E8E93</color>
    <color name="console_icon">#C7C7CC</color>
    <color name="console_divider">#2A2A2E</color>

    <!-- 自渲染广告卡片（与 SDK 内置模板同一套配色） -->
    <color name="ad_title">#222222</color>
    <color name="ad_desc">#999999</color>
    <color name="ad_cta">#2E6DF6</color>
    <color name="ad_badge_bg">#66000000</color>
    <color name="ad_close">#999999</color>
